{
  "name": "skateport",
  "globIgnorePaths": [
    "src/roblox/world_geometry.luau",
    "src/roblox/board_demo.luau"
  ],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "SkatePort": {
        "$className": "Folder",
        "roblox": {
          "$path": "src/roblox"
        }
      },
      "SkateLocator": {
        "$path": "place/skate_locator.luau"
      }
    },
    "ServerStorage": {
      "SkateLib": {
        "$className": "ScreenGui",
        "$properties": {
          "ResetOnSpawn": false
        },
        "Skate3": {
          "$className": "Folder",
          "sim": {
            "$path": "build/sim.rbxm"
          },
          "sim_data": {
            "$path": "build/sim_data.rbxm"
          }
        }
      }
    },
    "ServerScriptService": {
      "Skate3Admin": {
        "$path": "server/skate3_admin.server.luau"
      },
      "Skate3Net": {
        "$path": "server/skate3_net.server.luau"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Skate3Client": {
          "$path": "client/skate3.client.luau"
        }
      }
    }
  }
}
